
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Course {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String
}

model Goal {
  id        Int     @id @default(autoincrement())
  category  String
  title     String
  completed Boolean @default(false)
}
