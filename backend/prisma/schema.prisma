generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Course {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String
}

model Assignment {
  id        Int      @id @default(autoincrement())
  title     String
  course    String
  dueDate   DateTime
  completed Boolean  @default(false)
}